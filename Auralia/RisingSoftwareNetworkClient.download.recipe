<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the current Rising Software macOS network client-side installer ZIP using the current misc/v6/setup_server_mac_V###.zip download convention.</string>

    <key>Identifier</key>
    <string>com.github.tafesa.download.RisingSoftwareNetworkClient</string>

    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>RisingSoftwareNetworkClient</string>

        <key>MAJOR_VERSION</key>
        <string>6</string>

        <key>SEARCH_PAGE</key>
        <string>https://www.risingsoftware.com/support/downloads-network</string>

        <key>SEARCH_PATTERN</key>
        <string>(?P&lt;url&gt;https://download\.risingsoftware\.com/misc/v%MAJOR_VERSION%/setup_server_mac_V(?P&lt;version&gt;\d+)\.zip)</string>
    </dict>

    <key>MinimumVersion</key>
    <string>1.0.0</string>

    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>URLTextSearcher</string>
            <key>Arguments</key>
            <dict>
                <key>url</key>
                <string>%SEARCH_PAGE%</string>
                <key>re_pattern</key>
                <string>%SEARCH_PATTERN%</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>URLDownloader</string>
            <key>Arguments</key>
            <dict>
                <key>url</key>
                <string>%url%</string>
                <key>filename</key>
                <string>%NAME%-Mac-V%version%.zip</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>EndOfCheckPhase</string>
        </dict>
    </array>
</dict>
</plist>
